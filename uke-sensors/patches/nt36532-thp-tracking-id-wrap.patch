+static int takeTrackingId(uint16_t &cursor,
+        const std::array<TouchCore::TrackerSlot,kFingerSlots> &previous,
+        const std::array<TouchCore::TrackerSlot,kFingerSlots> &next) {
+    for(unsigned attempt=0;attempt<=2*kFingerSlots;attempt++) {
+        const int id=cursor++;
+        const auto occupied=[&](const auto &slot){return slot.active && slot.tracking_id==id;};
+        if(!std::any_of(previous.begin(),previous.end(),occupied) &&
+           !std::any_of(next.begin(),next.end(),occupied))return id;
+    }
+    throw std::logic_error("No free touch tracking ID");
+}
