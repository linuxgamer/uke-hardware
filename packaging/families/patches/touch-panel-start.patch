+template<class Wait,class Notice>
+static bool wait_touch_panel(int descriptor,TouchPanelState &state,Wait wait,Notice notice) {
+    state=touch_panel_state(descriptor);
+    if(state.ready)return true;
+    notice();
+    while(running) {
+        wait();
+        if(!running)return false;
+        state=touch_panel_state(descriptor);
+        if(state.ready)return true;
+    }
+    return false;
+}
